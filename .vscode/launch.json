{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Bookstore API",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/api/main.go",
            "env": {
                "DB_HOST": "localhost",
                "DB_PORT": "5432",
                "DB_USER": "root",
                "DB_PASSWORD": "root",
                "DB_NAME": "bookstore_db",
                "DB_SSLMODE": "disable",
                "PORT": "8080",
                "ENV": "development"
            },
            "envFile": "${workspaceFolder}/env.template",
            "args": [],
            "showLog": true,
            "console": "integratedTerminal",
            "preLaunchTask": "go: build",
            "postDebugTask": "go: clean"
        },
        {
            "name": "Launch Bookstore API (Release)",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/bin/bookstore-api",
            "env": {
                "DB_HOST": "localhost",
                "DB_PORT": "5432",
                "DB_USER": "root",
                "DB_PASSWORD": "root",
                "DB_NAME": "bookstore_db",
                "DB_SSLMODE": "disable",
                "PORT": "8080",
                "ENV": "production"
            },
            "envFile": "${workspaceFolder}/env.template",
            "args": [],
            "showLog": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "env": {
                "DB_HOST": "localhost",
                "DB_PORT": "5432",
                "DB_USER": "root",
                "DB_PASSWORD": "root",
                "DB_NAME": "bookstore_db",
                "DB_SSLMODE": "disable"
            },
            "envFile": "${workspaceFolder}/env.template",
            "args": ["-test.v"]
        },
        {
            "name": "Debug Test (Package)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "env": {
                "DB_HOST": "localhost",
                "DB_PORT": "5432",
                "DB_USER": "root",
                "DB_PASSWORD": "root",
                "DB_NAME": "bookstore_db",
                "DB_SSLMODE": "disable"
            },
            "envFile": "${workspaceFolder}/env.template",
            "args": ["-test.v"]
        }
    ]
}
